# ==============================================================================
# Flash Peak TMS - Environment Configuration Template
# All secrets must remain as placeholders only in this file.
# ==============================================================================

# Application Environment
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Canonical Database (Turso / libSQL)
# For local development: file:local.sqlite
# For production Turso: libsql://[your-db].turso.io
TURSO_DATABASE_URL=file:local.sqlite
TURSO_AUTH_TOKEN=your_turso_auth_token_placeholder

# Tournament & Localization
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_TOURNAMENT_ID=

# WhatsApp (Baileys) Configuration
# Sockets and auth state are isolated outside business tables.
WA_AUTH_STATE_DIR=./auth_state
WA_CENTRAL_GROUP_JID=120363000000000000@g.us
# WA_ORGANIZER_JID / WA_ORGANIZER_PHONE MUST be set to the real organizer identity.
# Startup aborts if neither is configured (no example value is provided on purpose).
# WA_ORGANIZER_JID=6280000000000@s.whatsapp.net
# WA_ORGANIZER_PHONE=6280000000000
WA_RECONNECT_MAX_RETRIES=10
WA_RECONNECT_BASE_DELAY_MS=2000

# Flash Peak Media Service (Dedicated instance, Verax pattern)
# Running separately on its own port and storage directory (D-021, D-022, O-011)
MEDIA_SERVICE_PORT=4190
MEDIA_SERVICE_URL=http://127.0.0.1:4190
MEDIA_SERVICE_HMAC_SECRET=replace_with_secure_random_hmac_secret_min_32_bytes
MEDIA_STORAGE_ROOT=./services/flashpeak-media/storage

# AI Vision & Extraction Providers (Free tier rotated / load balanced)
# 1. Groq
GROQ_API_KEY=gsk_placeholder_groq_api_key
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini
GEMINI_API_KEY=AIzaSy_placeholder_gemini_api_key
GEMINI_VISION_MODEL=gemini-2.0-flash

# 3. Ollama Cloud
OLLAMA_CLOUD_BASE_URL=https://ollama.cloud.example.com
OLLAMA_CLOUD_API_KEY=ollama_cloud_token_placeholder
OLLAMA_VISION_MODEL=llama3.2-vision:latest

# Debounce & Intake Timing
DEBOUNCE_WINDOW_SECONDS=5
REPORT_SESSION_EXPIRY_MINUTES=10
REPORT_SESSION_MAX_EXTENSIONS=3
